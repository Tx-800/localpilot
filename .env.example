# --- Supabase ---------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, never expose

# --- Cron -------------------------------------------------------------
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" automatically.
CRON_SECRET=generate-a-long-random-string

# --- AI providers (leave blank to use the built-in mocks) -------------
AI_TEXT_PROVIDER=mock          # mock | openai
AI_IMAGE_PROVIDER=mock         # mock | openai | flux
OPENAI_API_KEY=                # platform.openai.com API key (a ChatGPT subscription does not include API access)
OPENAI_TEXT_MODEL=gpt-5-mini   # caption model; any chat-completions model with JSON mode
OPENAI_IMAGE_MODEL=gpt-image-1-mini  # or gpt-image-1.5 / gpt-image-2 for higher fidelity
OPENAI_IMAGE_QUALITY=medium    # low | medium | high — main image cost lever (invalid → medium)
OPENAI_TEXT_TEMPERATURE=       # optional; leave blank for GPT-5-family models, which reject custom temperature
REPLICATE_API_TOKEN=
FLUX_MODEL=black-forest-labs/flux-schnell

# --- Publishing -------------------------------------------------------
PUBLISH_MODE=mock              # mock | live
META_GRAPH_VERSION=v21.0
